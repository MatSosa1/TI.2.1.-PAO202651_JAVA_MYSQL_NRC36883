<?xml version="1.0" encoding="utf-8"?>
<!-- Encabezado del inicio de sesión: degradado de la paleta y dos círculos translúcidos decorativos. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="@color/ap_primario"
                android:startColor="@color/ap_primario_oscuro" />
        </shape>
    </item>
    <item
        android:width="220dp"
        android:height="220dp"
        android:end="-70dp"
        android:gravity="top|end"
        android:top="-60dp">
        <shape android:shape="oval">
            <solid android:color="#14FFFFFF" />
        </shape>
    </item>
    <item
        android:width="140dp"
        android:height="140dp"
        android:bottom="-50dp"
        android:gravity="bottom|start"
        android:start="-40dp">
        <shape android:shape="oval">
            <solid android:color="#0FFFFFFF" />
        </shape>
    </item>
</layer-list>
