<?xml version="1.0" encoding="utf-8"?>
<!-- ECUD4 Registrar País: consultar el nombre en la API, elegir un resultado y «Registrar». -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/asa_hoja_fondo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:accessibilityHeading="true"
        android:fontFamily="sans-serif-medium"
        android:text="@string/nuevo_titulo"
        android:textColor="@color/ap_primario"
        android:textSize="22sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilConsulta"
            style="@style/Campo"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:hint="@string/nombre_pais"
            app:startIconDrawable="@drawable/ic_globo">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtConsulta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLength="101"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConsultar"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/consultar"
            app:cornerRadius="12dp"
            app:strokeColor="@color/ap_primario" />
    </LinearLayout>

    <TextView
        android:id="@+id/lblError"
        style="@style/AvisoError"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/prgCargando"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/ap_primario" />

    <TextView
        android:id="@+id/lblElija"
        style="@style/Etiqueta"
        android:layout_marginTop="16dp"
        android:text="@string/elija_pais"
        android:visibility="gone" />

    <RadioGroup
        android:id="@+id/grupoResultados"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelar"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/cancelar"
            app:cornerRadius="12dp"
            app:strokeColor="@color/ap_primario" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegistrar"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:enabled="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/registrar"
            app:backgroundTint="@color/boton_primario_fondo"
            app:cornerRadius="12dp" />
    </LinearLayout>
</LinearLayout>
